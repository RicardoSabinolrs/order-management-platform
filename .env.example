# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=console          # console | json (json em produção, para o Loki)

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
POSTGRES_USER=order_management
POSTGRES_PASSWORD=order_management
POSTGRES_DB=order_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Web
#
# Somente variaveis com o prefixo VITE_ chegam ao navegador. As demais (senha
# do banco, por exemplo) ficam no servidor.
# ---------------------------------------------------------------------------

# true  -> sobe com dados de demonstracao (MSW), sem precisar do backend
# false -> fala com a API de verdade
VITE_USE_MOCKS=true

# Base da API no navegador. Vazio = mesmo origin, e o proxy do Vite encaminha
# /api e /health para o backend. Preencher so se a API estiver em outro dominio.
VITE_API_BASE_URL=

# Para onde o proxy do Vite encaminha em desenvolvimento.
API_PROXY_TARGET=http://localhost:8000
